{
  "name": "catalogify/backend",
  "description": "Catalogify backend API and catalog generation engine",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.5 <8.6",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "doctrine/doctrine-migrations-bundle": "^3.3",
    "doctrine/orm": "^3.0",
    "symfony/console": "8.1.*",
    "symfony/doctrine-messenger": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/flex": "^2.11",
    "symfony/framework-bundle": "8.1.*",
    "symfony/http-client": "8.1.*",
    "symfony/messenger": "8.1.*",
    "symfony/redis-messenger": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/serializer": "8.1.*",
    "symfony/validator": "8.1.*",
    "symfony/yaml": "8.1.*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^13.0",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": true,
      "symfony/flex": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --memory-limit=1G",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "qa": ["@cs:check", "@analyse", "@test"],
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  },
  "extra": {"symfony": {"require": "8.1.*"}},
  "minimum-stability": "stable",
  "prefer-stable": true
}
